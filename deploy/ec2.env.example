# =============================================================================
# KICCPA on EC2 — copy sections to the right place on your server
# =============================================================================

# --- Backend: backend/.env (PM2: kiccpa-backend) ---
# PORT=5000
# MONGODB_URI=mongodb+srv://...
# SMTP_*=...

# --- Frontend on THE SAME EC2 (PM2: kiccpa-web) ---
# Save as frontend/.env.production.local BEFORE `npm run build`
BACKEND_PROXY_URL=http://127.0.0.1:5000
NEXTAUTH_URL=https://kiccpa.com
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
ADMIN_EMAIL=your-admin@email.com
ADMIN_PASSWORD=your-secure-password

# Videos: local MP4 in frontend/public/ (no S3 credentials needed)
NEXT_PUBLIC_USE_LOCAL_VIDEOS=true

# OR videos from S3 (requires IAM role or keys on EC2):
# S3_RESOURCES_BUCKET=kiccpa-resources
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# --- Frontend on Amplify + backend on EC2 (set in Amplify Console) ---
# BACKEND_PROXY_URL=http://YOUR-EC2-PUBLIC-IP:5000
#   OR https://api.yourdomain.com  (if Nginx proxies to :5000)
# S3_RESOURCES_BUCKET=kiccpa-resources
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=...          # required on Amplify (no instance role)
# AWS_SECRET_ACCESS_KEY=...
