# =============================================================================
# KICCPA on EC2 — copy sections to the right place on your server
# =============================================================================

# --- Backend: ~/kiccpa-website/backend/.env (PM2: kiccpa-backend) ---
PORT=5000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster2.xxxxx.mongodb.net/kiccpa?retryWrites=true&w=majority

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=itsupport@yourdomain.com
SMTP_PASS=YOUR_SMTP_PASSWORD

LEADS_NOTIFY_TO=info@kiccpa.com,info@kamglobalai.com

# Optional on backend (not read by Express today — mirror on frontend for S3 videos):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET_NAME=kiccpa-resources
# S3_RESOURCES_BUCKET=kiccpa-resources

# --- Frontend: ~/kiccpa-website/frontend/.env.production.local
# Create BEFORE `npm run build` and restart PM2 with --update-env
BACKEND_PROXY_URL=http://127.0.0.1:5000
NEXT_PUBLIC_BACKEND_URL=https://kiccpa.com
NEXTAUTH_URL=https://kiccpa.com
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
ADMIN_EMAIL=your-admin@email.com
ADMIN_PASSWORD=your-secure-password
NEXT_PUBLIC_SITE_URL=https://kiccpa.com

# Production videos from S3 (set false or omit NEXT_PUBLIC_USE_LOCAL_VIDEOS):
# NEXT_PUBLIC_USE_LOCAL_VIDEOS=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=kiccpa-resources
S3_RESOURCES_BUCKET=kiccpa-resources

# --- PM2 (optional): deploy/ec2-pm2.ecosystem.cjs sets BACKEND_PROXY_URL + bucket for kiccpa-web
# pm2 start deploy/ec2-pm2.ecosystem.cjs && pm2 save

# --- Frontend on Amplify + backend on EC2 (set in Amplify Console) ---
# BACKEND_PROXY_URL=http://YOUR-EC2-PUBLIC-IP:5000
# NEXT_PUBLIC_BACKEND_URL=https://api.yourdomain.com
# AWS_* and S3_RESOURCES_BUCKET as above
